{
  "name": "Fluid React Dev Environment",
  "image": "continuumio/miniconda3",
  "postCreateCommand": "./.devcontainer/VScontainer-setup.sh && conda init bash && source ~/.bashrc && ./devcontainer-setup.sh",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace"
}
