{
  "name": "Fluid React Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu", 
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode"
      ]
    },
    "settings": {
      "python.defaultInterpreterPath": "/opt/conda/envs/fluid/bin/python"
  },
  "postCreateCommand": "conda env create -f backend/environment.yml && npm install --prefix frontend",
  "forwardPorts": [5001, 3000],
  "service": "backend",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace"
  }
}
