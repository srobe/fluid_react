# Use Node.js as the base image
FROM node:16

# Set the working directory
WORKDIR /app

# Copy package.json and install dependencies
COPY package*.json ./
RUN npm install

# Copy the app source code
COPY . .

# Build the app
RUN npm run build

# Expose port 3000
EXPOSE 3000

# Command to start the app
CMD ["npm", "start"]
